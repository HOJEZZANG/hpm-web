{
  "name": "hpm-web",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node scripts/business-browser-check.mjs",
    "test:experience": "node scripts/experience-browser-check.mjs",
    "test:home:browser": "node scripts/home-browser-check.mjs",
    "test:home-search:browser": "node scripts/home-search-browser-check.mjs",
    "test:issue:browser": "node scripts/issue-form-browser-check.mjs",
    "test:weekly:browser": "node scripts/weekly-browser-check.mjs",
    "test:weekly:runtime": "node scripts/weekly-runtime-check.mjs",
    "build:xlsx": "node scripts/build-xlsx-worker.mjs",
    "build:ahu-pnd": "node scripts/build-ahu-pnd.mjs",
    "test:ahu-pnd:browser": "node scripts/ahu-pnd-browser-check.mjs",
    "test:runtime": "wrangler deploy --dry-run --outdir .wrangler/build && node scripts/runtime-check.mjs",
    "check:security": "node scripts/security-check.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "saxes": "^6.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "linkedom": "^0.18.13",
    "miniflare": "^5.20261012.0-beta",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
